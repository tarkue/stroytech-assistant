# Export these variables in the shell before starting the application.
# .env files are not loaded automatically. Never commit a real key.
STROYTECH_PROVIDER=ollama
STROYTECH_TIMEOUT=120
# For OpenRouter selected in the UI or STROYTECH_PROVIDER:
# Model is required here unless supplied by config.toml or entered in the UI.
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
